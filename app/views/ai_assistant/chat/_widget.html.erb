<%
  custom_image = Setting.plugin_redmine_ai_assistant.try(:[], 'custom_pet_image_url').presence
  pet_size     = (Setting.plugin_redmine_ai_assistant.try(:[], 'pet_size') || '60').to_i
  avatar_html  = custom_image ? "<img src='#{h(custom_image)}' alt='AI' style='width:100%;height:100%;border-radius:50%;object-fit:cover;'>".html_safe : "🤖"
  # 当前登录用户的 Redmine 头像（Gravatar 或首字母圆形），用于聊天消息中的用户气泡
  user_avatar_html = ''
  if respond_to?(:avatar) && User.current && !User.current.is_a?(AnonymousUser)
    begin
      # 转为普通 String 以便在下方用 CGI::escapeHTML 安全转义；
      # image_tag 返回的是 SafeBuffer，`ERB::Util.h` 对其无效会导致属性内 `"` 未转义，
      # 从而破坏外层 HTML 结构。
      user_avatar_html = avatar(User.current, size: 32).to_str
    rescue StandardError
      user_avatar_html = ''
    end
  end
  # AI 是否就绪：有启用的服务商且其 API key 已填写（API key 是管理员集中配置的）
  # 注意：视图模板在 AiAssistant::ChatController 视图上下文渲染，常量查找从 AiAssistant 模块开始，
  # 必须用完整命名空间 AiAssistant::AiProvider，否则报 NameError。
  ai_provider_scope = AiAssistant::AiProvider.enabled
  ai_ready = ai_provider_scope.exists? && ai_provider_scope.where.not(api_key: [nil, '']).exists?
%>
<div id="redmine-ai-assistant-widget"
     data-chat-csrf-value="<%= form_authenticity_token %>"
     data-custom-avatar="<%= custom_image %>"
     data-welcome-text="<%= j l(:text_ai_welcome) %>"
     data-readonly-text="<%= j l(:text_readonly_disclaimer) %>"
     data-question-1="<%= j l(:label_quick_question_1) %>"
     data-question-2="<%= j l(:label_quick_question_2) %>"
     data-current-user-name="<%= j User.current.name %>"
     data-current-user-login="<%= j User.current.login %>"
     data-current-user-avatar="<%= h user_avatar_html %>"
     data-ai-ready="<%= ai_ready %>"
     data-ai-disabled-hint="<%= j l(:hint_ai_send_btn_disabled) %>"
     data-logout-url="<%= j main_app.signout_path %>"
     data-my-account-url="<%= j main_app.url_for(controller: '/my', action: 'account', only_path: true) %>"
     aria-hidden="true">
  <!-- 当前用户头像模板：JS 通过 querySelector 读取，避免 data 属性中 HTML 转义复杂度 -->
  <template id="redmine-ai-assistant-user-avatar-template"><%= user_avatar_html.html_safe %></template>
  <!-- 悬浮宠物按钮 -->
  <button id="redmine-ai-assistant-chat-toggle"
          class="redmine-ai-assistant-chat-toggle<%= ' redmine-ai-assistant-chat-toggle--custom' if custom_image %>"
          aria-label="<%= l(:label_ai_chat_toggle) %>"
          title="<%= l(:label_ai_chat_toggle) %>"
          style="<%= "width:#{pet_size}px;height:#{pet_size}px;" if custom_image %>">
    <% if custom_image %>
      <span class="redmine-ai-assistant-pet-image">
        <img src="<%= custom_image %>"
             alt="AI"
             style="width:<%= pet_size %>px;height:<%= pet_size %>px;" />
      </span>
      <span class="redmine-ai-assistant-pet-shadow" style="<%= "width:#{pet_size * 0.65}px;" %>"></span>
    <% else %>
      <span class="redmine-ai-assistant-pet">🤖</span>
      <span class="redmine-ai-assistant-pet-shadow"></span>
    <% end %>
  </button>

  <!-- 聊天窗口 -->
  <div id="redmine-ai-assistant-chat-window" class="redmine-ai-assistant-chat-window redmine-ai-assistant-chat-hidden" style="display: none;">
    <!-- 头部 -->
    <div class="redmine-ai-assistant-chat-header">
      <div class="redmine-ai-assistant-chat-header-title">
        <span class="redmine-ai-assistant-chat-avatar"><%= avatar_html %></span>
        <span><%= l(:label_ai_assistant) %></span>
        <span class="redmine-ai-assistant-chat-status" data-redmine-ai-assistant-chat-target="status">🟢</span>
      </div>
      <div class="redmine-ai-assistant-chat-header-actions">
        <button class="redmine-ai-assistant-chat-action-btn"
                data-action="fullscreen"
                title="全屏展示">⤢</button>
        <button class="redmine-ai-assistant-chat-action-btn"
                data-action="newConversation"
                title="<%= l(:label_new_conversation) %>">➕</button>
        <button class="redmine-ai-assistant-chat-action-btn"
                data-action="toggle"
                title="<%= l(:label_close) %>">✕</button>
      </div>
    </div>

    <!-- 报告快捷操作栏 -->
    <div class="redmine-ai-assistant-chat-report-bar">
      <button class="redmine-ai-assistant-chat-report-btn"
              data-action="pickPeriod"
              data-report-type="daily">
        📅 <%= l(:label_daily_report) %>
      </button>
      <button class="redmine-ai-assistant-chat-report-btn"
              data-action="pickPeriod"
              data-report-type="weekly">
        📊 <%= l(:label_weekly_report) %>
      </button>
      <button class="redmine-ai-assistant-chat-report-btn"
              data-action="pickPeriod"
              data-report-type="monthly">
        📈 <%= l(:label_monthly_report) %>
      </button>
    </div>

    <!-- 时间周期选择器（点击报告按钮后显示） -->
    <div id="redmine-ai-assistant-chat-period-picker"
         class="redmine-ai-assistant-chat-period-picker"
         style="display:none;">
      <span class="redmine-ai-assistant-chat-period-label">选择报告周期：</span>
      <button class="redmine-ai-assistant-chat-period-option" data-period-offset="0">今日</button>
      <button class="redmine-ai-assistant-chat-period-option" data-period-offset="-1">昨日</button>
    </div>

    <!-- 消息列表 -->
    <div id="redmine-ai-assistant-chat-messages"
         class="redmine-ai-assistant-chat-messages"
         data-redmine-ai-assistant-chat-target="messages">
    </div>

    <!-- 输入区域 -->
    <div class="redmine-ai-assistant-chat-input-area">
      <textarea id="redmine-ai-assistant-chat-input"
                class="redmine-ai-assistant-chat-input"
                placeholder="<%= l(:label_ai_input_placeholder) %>"
                rows="1"
                data-redmine-ai-assistant-chat-target="input"></textarea>
      <button id="redmine-ai-assistant-chat-send"
              class="redmine-ai-assistant-chat-send-btn"
              <%= 'disabled' unless ai_ready %>
              <%= "title=\"#{j l(:hint_ai_send_btn_disabled)}\"" unless ai_ready %>>
        <span class="ai-send-icon">➤</span>
      </button>
    </div>

    <!-- 状态栏 -->
    <div class="redmine-ai-assistant-chat-statusbar" data-redmine-ai-assistant-chat-target="statusBar" style="display:none;">
      <span class="ai-typing-indicator">
        <span class="ai-typing-dot"></span>
        <span class="ai-typing-dot"></span>
        <span class="ai-typing-dot"></span>
      </span>
      <span><%= l(:label_ai_thinking) %></span>
    </div>
  </div>
</div>
